# constellation | creature | fish
NEXT_PUBLIC_VISUALIZATION_DESIGN=fish

# Allows the synthetic test dataset in a production build. Leave unset during the exhibition.
# ENABLE_SYNTHETIC_DATASET=true

# When the exhibition opened, with its time zone. The shared tank holds only creatures released from
# then on; earlier ones stay in the database. Leave unset to keep every creature.
# EXHIBITION_OPENED_AT=2026-10-15T17:00:00+02:00
